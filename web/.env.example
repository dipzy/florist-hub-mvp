# URL base da API (sem barra final). No Cloudflare Pages, definir no projeto (build).
# A Function de SEO lê API_BASE_URL em runtime; use o mesmo endereço.
VITE_API_BASE_URL=http://localhost:5183
# VITE_API_URL=http://localhost:5183
# Slug da loja pública em localhost (alternativa: ?tenant=flores-lina na URL)
VITE_DEFAULT_TENANT_SLUG=flores-lina
# Domínio base da plataforma (subdomínios {slug}.{base})
VITE_BASE_DOMAIN=
# Sentry (opcional). Source maps: upload desligado no build — ver docs/seguranca.md
# VITE_SENTRY_DSN=
