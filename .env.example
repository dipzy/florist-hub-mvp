# Copiar para .env local (não commitar). Em produção, colar no painel (Render, Cloudflare, Neon, R2).
# Nomes com __ são a forma de ambiente de chaves JSON aninhadas (Jwt:Key → Jwt__Key).

# --- PostgreSQL (Neon) ---
# App: URI pooled, com sslmode=require. Ex.: postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Migrações, pg_dump e restauro: URI directa, sem "-pooler".
DATABASE_URL_UNPOOLED=
# Alternativa explícita. Se estiver preenchida, ganha a DATABASE_URL.
ConnectionStrings__DefaultConnection=
# Opcional. Se vazio, as migrações usam DATABASE_URL_UNPOOLED e, em último caso, a ligação da app.
ConnectionStrings__Migrations=

# --- API ---
ASPNETCORE_ENVIRONMENT=Production
# O Render injeta PORT. A imagem usa 8080 se a variável não existir.
PORT=8080
# true no Koyeb (não há pré-deploy). false no Render, que corre `dotnet FloristHub.Api.dll --migrate`.
Database__MigrateOnStartup=false

# --- Sentry (opcional; sem PII) ---
Sentry__Dsn=
Sentry__TracesSampleRate=0.1
Sentry__Environment=
Sentry__Release=

# --- JWT (obrigatório em produção; mínimo 32 caracteres) ---
Jwt__Key=
Jwt__Issuer=FloristHub
Jwt__Audience=FloristHubClients
Jwt__ExpiresHours=8

# --- Domínios e CORS ---
# Apex da plataforma. Origens https desse host e de *.App__BaseDomain são aceites.
App__BaseDomain=floristhub.pt
# URL pública da web. Base dos links de convite (/convite), dos outros emails e do regresso de pagamento.
App__WebBaseUrl=https://floristhub.pt
# Origens extra, separadas por vírgula (Pages, previews). localhost já é aceite.
Cors__AllowedOrigins=https://florist-hub.pages.dev,https://floristhub.pt,https://www.floristhub.pt

# --- Imagens (Cloudflare R2, API S3) ---
# Local | S3 | R2. R2 e S3 usam o mesmo cliente.
Storage__Provider=R2
Storage__S3__ServiceUrl=https://ACCOUNT_ID.r2.cloudflarestorage.com
Storage__S3__Bucket=florist-hub
Storage__S3__AccessKeyId=
Storage__S3__SecretAccessKey=
# URL pública de leitura (r2.dev ou domínio próprio do bucket). Os objetos ficam com este prefixo.
Storage__S3__PublicBaseUrl=https://pub-xxxx.r2.dev
Storage__S3__Region=auto
Storage__S3__ForcePathStyle=true
# Disco local (desenvolvimento)
Storage__Local__RootPath=uploads
Storage__Local__PublicBasePath=/api/files

# --- Email (Resend por HTTP; o Render Free bloqueia SMTP) ---
Email__Provider=Log
# Email__Provider=Resend
Email__ResendApiKey=
Email__From=Florist Hub <ola@floristhub.pt>
Email__MaxSendAttempts=3
# Se preenchido, substitui App__WebBaseUrl nos links dos emails, incluindo o convite da florista.
Email__WebBaseUrl=

# --- Stripe (vazio = pagamentos desligados) ---
# Não defina Stripe__Provider. O valor Fake só está em appsettings.Development.json.
# Com ASPNETCORE_ENVIRONMENT=Production a API ignora Fake: usa a secret key, ou desliga os pagamentos se ela estiver vazia.
# Teste: sk_test_ / pk_test_ / whsec_ do Stripe CLI.
# Produção: sk_live_ / pk_live_ / whsec_ do endpoint https://<api>/api/stripe/webhook
Stripe__SecretKey=
Stripe__PublishableKey=
Stripe__WebhookSecret=

# --- Encomendas recorrentes (opcional; os valores abaixo são os da aplicação) ---
# Cupões, campanhas, avaliações, capacidade e stock não têm variáveis de ambiente.
RecurringOrders__GenerationAdvanceDays=3
RecurringOrders__PollIntervalSeconds=60
RecurringOrders__GenerationLeaseSeconds=120

# --- Faturação ---
# A chave InvoiceXpress de cada florista guarda-se cifrada na base, no ecrã da loja, não aqui.
Invoicing__RetryIntervalSeconds=60
# Invoicing__AllowFakeProvider=false

# --- Push (FCM HTTP v1). Sem credenciais fica em log. ---
Push__Provider=Log
# Push__Provider=Fcm
Push__FcmProjectId=
Push__FcmServiceAccountJson=
Push__FcmServiceAccountPath=
Push__MaxSendAttempts=3

# --- Outros ---
Features__DisableRateLimiting=false
Serilog__MinimumLevel__Default=Information

# --- Web (Vite, no build do Cloudflare Pages) ---
VITE_API_BASE_URL=https://florist-hub-api.onrender.com
# Alias aceite pelo cliente: VITE_API_URL
VITE_BASE_DOMAIN=floristhub.pt
VITE_DEFAULT_TENANT_SLUG=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
# Runtime das Pages Functions (sitemap, robots, HTML de crawlers). O mesmo valor que VITE_API_BASE_URL.
API_BASE_URL=https://florist-hub-api.onrender.com

# --- Cópias de segurança (scripts/backup-neon-to-r2.sh; GitHub Actions: segredos BACKUP_S3_*) ---
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=backups/floristhub
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=florist-hub
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=backups/floristhub
BACKUP_RETENTION_DAYS=14
# RESTORE_I_UNDERSTAND=yes

